# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string. Replace placeholders with local development values.
DATABASE_URL=postgresql://kubecart_dev:replace_me@localhost:5432/kubecart_dev?schema=public

# Comma-separated allowlist of browser origins. Never use "*" with credentials.
CORS_ORIGIN=http://localhost:5173

# Set true only when the API runs behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Use a long, random development-only value. Never reuse this placeholder.
SESSION_SECRET=replace_with_a_long_random_secret_for_local_development

# Disposable PostgreSQL database for integration tests. Name must contain "test".
# TEST_DATABASE_URL=postgresql://kubecart_test:replace_me@localhost:5432/kubecart_test?schema=public

# Paystack test credentials only. Keep secret key server-side.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Inventory reservation lifetime in minutes; agree on policy before implementation.
INVENTORY_RESERVATION_MINUTES=15

# Flat-rate delivery fee in kobo (e.g. 150000 = 1,500 NGN)
DEFAULT_DELIVERY_FEE_KOBO=150000

# Initial administrator seed credentials (used by `npm run db:seed`)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_admin_password
INITIAL_ADMIN_NAME=Admin

# Supabase Storage for private product-image uploads. Keep the secret key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_server_side_secret_key
SUPABASE_BUCKET=kubecart-product-images
